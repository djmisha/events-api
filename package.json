{
  "name": "events-api",
  "version": "1.0.0",
  "description": "Event Aggregator API with Supabase Cache Control",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "cleanup": "ts-node -e \"require('./src/jobs/cleanup').execute()\"",
    "genres:bootstrap": "ts-node src/jobs/bootstrapGenres.ts",
    "genres:backfill": "ts-node src/jobs/backfillEventGenres.ts",
    "vercel-build": "tsc",
    "lint": "./scripts/pre-commit.sh",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test-build": "npm run build && node dist/server.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "node-fetch": "^3.3.2",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "events",
    "api",
    "express",
    "supabase",
    "cache-control",
    "serverless",
    "vercel"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  }
}
